# Copy this file to `.env` and fill in real values.

# ---------------------------------------------------------------------------
# Database — Neon PostgreSQL
# ---------------------------------------------------------------------------
# Use Neon's POOLED connection string (host contains `-pooler`) for the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/scoolr?sslmode=verify-full"

# Neon's DIRECT (unpooled) connection string. Migrations need a direct
# connection because the pooler does not support the advisory locks Prisma uses.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/scoolr?sslmode=verify-full"

# Optional: a second empty database used as the shadow DB by `prisma migrate dev`.
# SHADOW_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Auth — Neon Auth (Managed Better Auth)
# ---------------------------------------------------------------------------
# Auth endpoint for the Neon project. Get it with:
#   npx neonctl neon-auth list --project-id <project-id>
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.us-east-1.aws.neon.tech"

# Signs session cookies. Must be at least 32 characters.
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# ---------------------------------------------------------------------------
# Email — Resend (https://resend.com)
# ---------------------------------------------------------------------------
# Optional. Without it, invitations are still created but no email is sent —
# the UI hands you the link to share manually instead.
RESEND_API_KEY=""

# Sender address. Must be on a domain you have verified in Resend; until you
# verify one, Resend only delivers to your own account's email address.
EMAIL_FROM="Scoolr <noreply@yourdomain.com>"

# Absolute base URL used to build invitation links. Falls back to the request
# host in development, so it is only required in production.
# NEXT_PUBLIC_APP_URL="https://scoolr.yourdomain.com"

# ---------------------------------------------------------------------------
# Tenancy
# ---------------------------------------------------------------------------
# Used by `npm run db:seed` only, to name the school it creates for local
# development. The app no longer resolves tenancy from this — each user's
# school comes from their own account, so several schools can coexist.
SCOOLR_SCHOOL_SLUG="demo-secondary-school"

# Display name for that school. Defaults to the slug title-cased
# ("triumphant_baptist_college" -> "Triumphant Baptist College").
# SCOOLR_SCHOOL_NAME=""

# `npm run db:seed` always creates the school, academic session/term and the
# JSS 1–SSS 3 classes. Set this to "true" to ALSO seed the sample roster
# (fictional teachers, students, attendance, subjects, events, billing).
# Leave unset for a real school.
# SCOOLR_SEED_DEMO_DATA="true"
